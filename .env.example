# ─────────────────────────────────────────────
# Portfolio Backend — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env to GitHub.
# ─────────────────────────────────────────────

# Your Gmail address (used to send emails)
GMAIL_USER=xxxx_xxxx_xxxx_xxxx

# Gmail App Password (NOT your regular Gmail password)
# How to get it:
#   1. Go to myaccount.google.com
#   2. Security → 2-Step Verification → turn ON
#   3. Security → App Passwords → select "Mail" + "Other"
#   4. Copy the 16-char password here (no spaces)
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Your email — where YOU receive notifications
NOTIFY_EMAIL=xxxx_xxxx_xxxx_xxxx

# Frontend URL (for CORS — your Vercel URL)
FRONTEND_URL=xxxx_xxxx_xxxx_xxxx

# Port (Render sets this automatically)
PORT=5000
